<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <queries>
        <!-- Voice notes hand off to the phone's speech recognizer. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".StickyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickyNotes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- App-drawer icons come in light and dark pairs; LauncherIcons enables the one
             that matches the app's theme. Light is on by default. -->
        <activity-alias
            android:name=".LauncherLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Opens straight into a blank note. Add it to the S Pen's Air command for one-tap notes. -->
        <activity
            android:name=".QuickNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_quicknote"
            android:label="@string/quick_note"
            android:noHistory="true"
            android:roundIcon="@mipmap/ic_quicknote"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".QuickNoteLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_quicknote"
            android:label="@string/quick_note"
            android:roundIcon="@mipmap/ic_quicknote"
            android:targetActivity=".QuickNoteActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".QuickNoteDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_quicknote_dark"
            android:label="@string/quick_note"
            android:roundIcon="@mipmap/ic_quicknote_dark"
            android:targetActivity=".QuickNoteActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Hey Google, open Sticky voice note": listen once, save the note, close. -->
        <activity
            android:name=".capture.VoiceNoteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/voice_note"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity-alias
            android:name=".VoiceNoteLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_voicenote"
            android:label="@string/voice_note"
            android:roundIcon="@mipmap/ic_voicenote"
            android:targetActivity=".capture.VoiceNoteActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".VoiceNoteDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_voicenote_dark"
            android:label="@string/voice_note"
            android:roundIcon="@mipmap/ic_voicenote_dark"
            android:targetActivity=".capture.VoiceNoteActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Share to Sticky Notes (e.g. from Gemini), and "Add to Sticky Notes" when selecting text. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/add_to_sticky_notes">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- S Pen helper: notices the pen being pulled out and opens a new note.
             Accessibility is the only way Android lets an app open itself in response. -->
        <service
            android:name=".spen.PenHelperService"
            android:exported="true"
            android:label="@string/pen_helper_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pen_helper" />
        </service>

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
