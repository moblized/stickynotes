<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Sticky Notes reach a home Mealie server: plain http:// addresses on your network,
     and certificates you've installed yourself, as well as normal https:// sites. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
